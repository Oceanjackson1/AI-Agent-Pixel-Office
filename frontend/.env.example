# Vercel / Vite frontend configuration
# Copy to frontend/.env.local for local testing,
# or add the same keys in Vercel Project Settings -> Environment Variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Legacy alias still supported by this project:
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Optional: only needed when you want to force local FastAPI WebSocket mode
# VITE_WS_URL=ws://localhost:8000/ws/office
